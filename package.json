{
  "name": "titvex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender-node.mjs && node scripts/check-seo.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "check:seo": "node scripts/check-seo.mjs",
    "check:leads": "node scripts/check-leads.mjs",
    "lint": "eslint .",
    "lint:leads": "eslint \"src/components/leads/**/*.{ts,tsx}\" \"src/lib/leads.ts\" \"src/lib/analytics.ts\" \"src/lib/hotjar.ts\" \"src/lib/consent.ts\" \"src/components/ConsentBanner.tsx\" \"src/components/ScrollDepthTracker.tsx\" \"src/pages/NotFoundPage.tsx\" \"api/leads.ts\" \"api/_leadsDelivery.ts\" \"api/_leadsRateLimit.ts\" \"api/_leadsSubject.ts\"",
    "typecheck": "tsc --noEmit",
    "prerender": "node scripts/prerender-node.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "verify:hydration": "node scripts/verify-hydration.mjs",
    "test": "node scripts/check-leads.mjs && node --experimental-strip-types scripts/check-mileseal-demo-state.mjs && node --experimental-strip-types scripts/check-mileseal-case-demo-state.mjs && node --experimental-strip-types scripts/check-mileseal-leads-meta.mjs && node --experimental-strip-types scripts/check-mileseal-analytics.mjs && node --experimental-strip-types scripts/check-mileseal-leads-integration.mjs",
    "test:mileseal:e2e": "node scripts/capture-mileseal-wave3.mjs && node --experimental-strip-types scripts/check-mileseal-pdf.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "cobe": "^2.0.1",
    "grammy": "^1.41.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "postprocessing": "^6.38.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.11.0",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.6.9",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.50.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
