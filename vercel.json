{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/_bot",
      "destination": "/api/telegram"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tivonix.tech" }],
      "destination": "https://www.tivonix.tech/:path*",
      "permanent": true
    }
  ]
}
