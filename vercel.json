{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/_bot",
      "destination": "/api/telegram"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tivonix.tech" }],
      "destination": "https://www.tivonix.tech/:path*",
      "permanent": true
    }
  ]
}