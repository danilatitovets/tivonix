# Site
VITE_SITE_URL=https://www.tivonix.tech
# Alias accepted by some docs (Vite only exposes VITE_* to the client)
# NEXT_PUBLIC_SITE_URL=https://www.tivonix.tech

# Google Ads (optional — conversion tracking)
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Partner panel (no trailing slash)
VITE_PARTNER_PANEL_URL=https://tivonixpanel-production.up.railway.app

# Hotjar (client — only loads after analytics cookie consent, production)
VITE_HOTJAR_ID=
VITE_HOTJAR_SV=6
# Set to 1 to allow Hotjar in development builds
VITE_HOTJAR_FORCE=

# Lead form delivery (server — Vercel /api/leads)
# Email is required for successful lead acceptance.
LEADS_EMAIL_TO=tivoonix@gmail.com
# Must be a verified Resend domain sender (do NOT use onboarding@resend.dev)
LEADS_EMAIL_FROM=TIVONIX <leads@tivonix.tech>
RESEND_API_KEY=

# Telegram notify for website leads (optional secondary channel)
TELEGRAM_BOT_TOKEN=
# Prefer a single chat id for lead alerts
TELEGRAM_CHAT_ID=
# Fallbacks already used by the Telegram bot webhook:
# TELEGRAM_ADMIN_CHAT_ID=
# ADMIN_IDS=
# BOT_TOKEN=
